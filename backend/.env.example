SPRING_PROFILES_ACTIVE=dev
POSTGRES_PORT=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=case_db
DB_USERNAME=case_user
DB_PASSWORD=case_password
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-this-development-secret-to-a-safe-32-byte-minimum
JWT_EXPIRATION_MINUTES=480

# Opcional: Google Gemini Vision para reconstrucción de diagramas desde imagen.
# Obtén una clave de autorización restringida en https://aistudio.google.com/apikey y nunca la pongas en el frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
